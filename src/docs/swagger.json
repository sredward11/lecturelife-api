{
  "openapi": "3.0.3",
  "info": {
    "title": "LectureLife API",
    "version": "1.0.0",
    "description": "API para gestão de livros e leituras com autenticação JWT."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor local"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Autenticação de usuários"
    },
    {
      "name": "Books",
      "description": "Gestão de livros"
    },
    {
      "name": "Readings",
      "description": "Gestão de leituras"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Informe apenas o token JWT."
      }
    },
    "parameters": {
      "idParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "ID do registro (ObjectId)",
        "schema": {
          "type": "string"
        }
      },
      "tituloQuery": {
        "name": "titulo",
        "in": "query",
        "description": "Filtrar por título",
        "schema": {
          "type": "string"
        }
      },
      "categoriaQuery": {
        "name": "categoria",
        "in": "query",
        "description": "Filtrar por categoria",
        "schema": {
          "type": "string"
        }
      },
      "statusQuery": {
        "name": "status",
        "in": "query",
        "description": "Filtrar por status",
        "schema": {
          "type": "string",
          "enum": [
            "planejando",
            "lendo",
            "concluido",
            "abandonado"
          ]
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Token não fornecido ou inválido"
      },
      "NotFound": {
        "description": "Recurso não encontrado"
      },
      "ValidationError": {
        "description": "Dados de entrada inválidos"
      },
      "NoContent": {
        "description": "Operação realizada com sucesso"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ]
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "Book": {
        "type": "object",
        "required": [
          "id",
          "titulo"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "titulo": {
            "type": "string"
          },
          "autor": {
            "type": "string"
          },
          "anoPublicacao": {
            "type": "integer"
          },
          "categoria": {
            "type": "string"
          },
          "paginasTotal": {
            "type": "integer"
          },
          "sinopse": {
            "type": "string"
          }
        }
      },
      "BookCreate": {
        "type": "object",
        "required": [
          "titulo"
        ],
        "properties": {
          "titulo": {
            "type": "string",
            "example": "Clean Code"
          },
          "autor": {
            "type": "string",
            "example": "Robert C. Martin"
          },
          "anoPublicacao": {
            "type": "integer",
            "example": 2008
          },
          "categoria": {
            "type": "string",
            "example": "Tecnologia"
          },
          "paginasTotal": {
            "type": "integer",
            "example": 464
          },
          "sinopse": {
            "type": "string",
            "example": "Boas práticas."
          }
        }
      },
      "BookUpdate": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string"
          },
          "autor": {
            "type": "string"
          },
          "anoPublicacao": {
            "type": "integer"
          },
          "categoria": {
            "type": "string"
          },
          "paginasTotal": {
            "type": "integer"
          },
          "sinopse": {
            "type": "string"
          }
        }
      },
      "Reading": {
        "type": "object",
        "required": [
          "id",
          "readingId",
          "bookId",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "readingId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "bookId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "planejando",
              "lendo",
              "concluido",
              "abandonado"
            ]
          },
          "dataInicio": {
            "type": "string",
            "format": "date-time"
          },
          "dataFim": {
            "type": "string",
            "format": "date-time"
          },
          "nota": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "paginasLidas": {
            "type": "integer"
          },
          "favorito": {
            "type": "boolean"
          },
          "book": {
            "$ref": "#/components/schemas/Book"
          }
        }
      },
      "ReadingCreate": {
        "type": "object",
        "required": [
          "bookId"
        ],
        "properties": {
          "bookId": {
            "type": "string",
            "example": "64d9f0c2c1e8a3b2f5a6d7e8"
          },
          "status": {
            "type": "string",
            "enum": [
              "planejando",
              "lendo",
              "concluido",
              "abandonado"
            ],
            "example": "lendo"
          },
          "paginasLidas": {
            "type": "integer",
            "example": 50
          },
          "favorito": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "ReadingUpdate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "planejando",
              "lendo",
              "concluido",
              "abandonado"
            ]
          },
          "dataInicio": {
            "type": "string",
            "format": "date-time"
          },
          "dataFim": {
            "type": "string",
            "format": "date-time"
          },
          "nota": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "paginasLidas": {
            "type": "integer"
          },
          "favorito": {
            "type": "boolean"
          }
        }
      },
      "ReadingStats": {
        "type": "object",
        "properties": {
          "totalLeituras": {
            "type": "integer"
          },
          "concluidos": {
            "type": "integer"
          },
          "totalPaginasLidos": {
            "type": "integer"
          },
          "mediaNotas": {
            "type": "number"
          }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Registrar novo usuário",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nome",
                  "email",
                  "senha"
                ],
                "properties": {
                  "nome": {
                    "type": "string",
                    "example": "Fulano"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "fulano@email.com"
                  },
                  "senha": {
                    "type": "string",
                    "format": "password",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login do usuário",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "senha"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "fulano@email.com"
                  },
                  "senha": {
                    "type": "string",
                    "format": "password",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/books": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Listar livros",
        "parameters": [
          {
            "$ref": "#/components/parameters/tituloQuery"
          },
          {
            "$ref": "#/components/parameters/categoriaQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de livros",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Books"
        ],
        "summary": "Criar livro",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Livro criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/books/{id}": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Buscar livro por ID",
        "parameters": [
          {
            "$ref": "#/components/parameters/idParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Livro encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "put": {
        "tags": [
          "Books"
        ],
        "summary": "Atualizar livro por ID",
        "parameters": [
          {
            "$ref": "#/components/parameters/idParam"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Livro atualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "delete": {
        "tags": [
          "Books"
        ],
        "summary": "Remover livro por ID",
        "parameters": [
          {
            "$ref": "#/components/parameters/idParam"
          }
        ],
        "responses": {
          "204": {
            "$ref": "#/components/responses/NoContent"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/readings": {
      "get": {
        "tags": [
          "Readings"
        ],
        "summary": "Listar leituras",
        "parameters": [
          {
            "$ref": "#/components/parameters/statusQuery"
          },
          {
            "$ref": "#/components/parameters/categoriaQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de leituras",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Reading"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Readings"
        ],
        "summary": "Criar leitura",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadingCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Leitura criada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reading"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/readings/stats": {
      "get": {
        "tags": [
          "Readings"
        ],
        "summary": "Estatísticas das leituras",
        "responses": {
          "200": {
            "description": "Resumo de leituras",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingStats"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/readings/{id}": {
      "get": {
        "tags": [
          "Readings"
        ],
        "summary": "Detalhar leitura",
        "parameters": [
          {
            "$ref": "#/components/parameters/idParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Leitura encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reading"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "put": {
        "tags": [
          "Readings"
        ],
        "summary": "Atualizar leitura",
        "parameters": [
          {
            "$ref": "#/components/parameters/idParam"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadingUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Leitura atualizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reading"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "delete": {
        "tags": [
          "Readings"
        ],
        "summary": "Remover leitura",
        "parameters": [
          {
            "$ref": "#/components/parameters/idParam"
          }
        ],
        "responses": {
          "204": {
            "$ref": "#/components/responses/NoContent"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  }
}