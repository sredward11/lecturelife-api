{
  "openapi": "3.0.3",
  "info": {
    "title": "LectureLife API",
    "version": "1.0.0",
    "description": "API para gestão de livros e leituras com autenticação JWT."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor local"
    }
  ],
  "tags": [
    { "name": "Auth", "description": "Autenticação de usuários" },
    { "name": "Books", "description": "Gestão de livros" },
    { "name": "Readings", "description": "Gestão de leituras" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "nome": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["user", "admin"] }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "Book": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "titulo": { "type": "string" },
          "autor": { "type": "string" },
          "anoPublicacao": { "type": "integer" },
          "categoria": { "type": "string" },
          "paginasTotal": { "type": "integer" },
          "sinopse": { "type": "string" }
        },
        "required": ["id", "titulo"]
      },
      "BookCreate": {
        "type": "object",
        "properties": {
          "titulo": { "type": "string", "example": "Clean Code" },
          "autor": { "type": "string", "example": "Robert C. Martin" },
          "anoPublicacao": { "type": "integer", "example": 2008 },
          "categoria": { "type": "string", "example": "Tecnologia" },
          "paginasTotal": { "type": "integer", "example": 464 },
          "sinopse": { "type": "string", "example": "Boas práticas de programação." }
        },
        "required": ["titulo"]
      },
      "BookUpdate": {
        "type": "object",
        "properties": {
          "titulo": { "type": "string" },
          "autor": { "type": "string" },
          "anoPublicacao": { "type": "integer" },
          "categoria": { "type": "string" },
          "paginasTotal": { "type": "integer" },
          "sinopse": { "type": "string" }
        }
      },
      "Reading": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "bookId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["planejando", "lendo", "concluido", "abandonado"]
          },
          "dataInicio": { "type": "string", "format": "date-time" },
          "dataFim": { "type": "string", "format": "date-time" },
          "nota": { "type": "number", "minimum": 0, "maximum": 10 },
          "paginasLidas": { "type": "integer" },
          "favorito": { "type": "boolean" },
          "book": { "$ref": "#/components/schemas/Book" }
        },
        "required": ["id", "bookId", "status"]
      },
      "ReadingCreate": {
        "type": "object",
        "properties": {
          "bookId": { "type": "string", "example": "64d9f0c2c1e8a3b2f5a6d7e8" },
          "status": {
            "type": "string",
            "enum": ["planejando", "lendo", "concluido", "abandonado"],
            "example": "lendo"
          },
          "dataInicio": { "type": "string", "format": "date-time" },
          "dataFim": { "type": "string", "format": "date-time" },
          "nota": { "type": "number", "example": 9 },
          "paginasLidas": { "type": "integer", "example": 120 },
          "favorito": { "type": "boolean", "example": true }
        },
        "required": ["bookId"]
      },
      "ReadingUpdate": {
        "type": "object",
        "properties": {
          "bookId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["planejando", "lendo", "concluido", "abandonado"]
          },
          "dataInicio": { "type": "string", "format": "date-time" },
          "dataFim": { "type": "string", "format": "date-time" },
          "nota": { "type": "number", "minimum": 0, "maximum": 10 },
          "paginasLidas": { "type": "integer" },
          "favorito": { "type": "boolean" }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Registrar novo usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string", "example": "Fulano" },
                  "email": { "type": "string", "format": "email", "example": "fulano@email.com" },
                  "senha": { "type": "string", "format": "password", "example": "123456" }
                },
                "required": ["nome", "email", "senha"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuário criado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } },
          "422": { "description": "Dados inválidos" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login do usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "fulano@email.com" },
                  "senha": { "type": "string", "format": "password", "example": "123456" }
                },
                "required": ["email", "senha"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login realizado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } },
          "401": { "description": "Credenciais inválidas" }
        }
      }
    },
    "/books": {
      "get": {
        "tags": ["Books"],
        "summary": "Listar livros",
        "parameters": [
          {
            "name": "titulo",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Filtrar por título"
          },
          {
            "name": "categoria",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Filtrar por categoria"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de livros",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Book" } } } }
          }
        }
      },
      "post": {
        "tags": ["Books"],
        "summary": "Criar livro",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BookCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Livro criado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Book" } } }
          },
          "422": { "description": "Dados inválidos" }
        }
      }
    },
    "/books/{idOrTitle}": {
      "get": {
        "tags": ["Books"],
        "summary": "Buscar livro por ID ou título",
        "parameters": [
          {
            "name": "idOrTitle",
            "in": "path",
            "required": true,
            "description": "ID do livro (ObjectId) ou título exato",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Livro encontrado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Book" } } }
          },
          "404": { "description": "Livro não encontrado" }
        }
      },
      "put": {
        "tags": ["Books"],
        "summary": "Atualizar livro por ID ou título",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "idOrTitle",
            "in": "path",
            "required": true,
            "description": "ID do livro (ObjectId) ou título exato",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BookUpdate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Livro atualizado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Book" } } } },
          "404": { "description": "Livro não encontrado" },
          "422": { "description": "Dados inválidos" }
        }
      },
      "delete": {
        "tags": ["Books"],
        "summary": "Remover livro por ID ou título",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "idOrTitle",
            "in": "path",
            "required": true,
            "description": "ID do livro (ObjectId) ou título exato",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Remoção realizada" },
          "404": { "description": "Livro não encontrado" }
        }
      }
    },
    "/readings": {
      "get": {
        "tags": ["Readings"],
        "summary": "Listar leituras do usuário",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["planejando", "lendo", "concluido", "abandonado"]
            },
            "description": "Filtrar por status"
          },
          {
            "name": "categoria",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Filtrar por categoria do livro"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de leituras",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Reading" } } } }
          }
        }
      },
      "post": {
        "tags": ["Readings"],
        "summary": "Criar leitura",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReadingCreate" },
              "example": {
                "bookId": "64d9f0c2c1e8a3b2f5a6d7e8",
                "status": "lendo",
                "paginasLidas": 50,
                "favorito": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Leitura criada",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reading" } } }
          },
          "422": { "description": "Dados inválidos" }
        }
      }
    },
    "/readings/{id}": {
      "get": {
        "tags": ["Readings"],
        "summary": "Detalhar leitura",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Leitura encontrada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reading" } } } },
          "404": { "description": "Leitura não encontrada" }
        }
      },
      "put": {
        "tags": ["Readings"],
        "summary": "Atualizar leitura",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReadingUpdate" },
              "example": {
                "status": "concluido",
                "dataInicio": "2024-01-01T00:00:00.000Z",
                "dataFim": "2024-01-10T00:00:00.000Z",
                "paginasLidas": 300,
                "nota": 9
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Leitura atualizada",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reading" } } }
          },
          "404": { "description": "Leitura não encontrada" },
          "422": { "description": "Dados inválidos" }
        }
      },
      "delete": {
        "tags": ["Readings"],
        "summary": "Remover leitura",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Leitura removida" },
          "404": { "description": "Leitura não encontrada" }
        }
      }
    },
    "/readings/stats": {
      "get": {
        "tags": ["Readings"],
        "summary": "Estatísticas das leituras do usuário",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Resumo de leituras",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "totalLeituras": { "type": "integer" },
                    "concluidos": { "type": "integer" },
                    "totalPaginasLidos": { "type": "integer" },
                    "mediaNotas": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}